# =============================================================================
# eBoom — production secrets & behaviour
# =============================================================================
# cp .env.prod.example .env.prod
#
# Loaded by compose.prod.yaml as the backend/caddy env_file — the only
# env_file the production containers read. compose.yaml (and its dev-only
# values in .env) is never loaded alongside compose.prod.yaml, so nothing
# here can be shadowed by a dev value, and TEST_USER_ID has no way to leak
# into prod.
#
# =============================================================================
# MUST CHANGE
# =============================================================================

# Signing key for access + refresh tokens. Minimum 32 chars.
#   generate with:  openssl rand -base64 48
JWT_SECRET=change-me-in-production-minimum-32-characters

# Public URL of the frontend. Used for email links, OpenRouter HTTP-Referer,
# and as the allowed CORS origin on the API. Must match EXACTLY what the
# browser shows — no trailing slash, correct scheme.
APP_URL=https://eboom.example.com

# NOTE: NEXT_PUBLIC_BASE_URL (the API URL baked into the frontend bundle) is
# a Compose build arg, not a container env var — it lives in .env, not here.
# See .env.example.

# =============================================================================
# Auth behaviour
# =============================================================================
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Domains + TLS (compose.prod.yaml + deploy/Caddyfile)
# =============================================================================
# DNS A records for all three must already point at this server — Caddy
# requests Let's Encrypt certificates on boot.
APP_DOMAIN=eboom.example.com
API_DOMAIN=api.eboom.example.com
DOCS_DOMAIN=docs.eboom.example.com

# Address Let's Encrypt uses for expiry and problem notices.
ACME_EMAIL=admin@example.com

# =============================================================================
# SMTP — required unless SKIP_EMAIL_VERIFICATION=1 (leave it at 0 in prod)
# =============================================================================
# There is no Mailpit in the prod overlay — fill in real SMTP credentials,
# otherwise mail silently fails to send.
SKIP_EMAIL_VERIFICATION=0
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@example.com

# =============================================================================
# AI insights & chat (optional)
# =============================================================================
# One provider-neutral set of variables. Leave unset to disable AI features —
# the AI endpoints then return a "not configured" error and nothing else breaks.
#
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
#
# (The legacy OPENAI_* / OPENROUTER_* names are still honoured as fallbacks,
#  but prefer the LLM_* names above — they take priority.)

# Background job that emails users about overdue items.
# NOTIFICATION_EMAIL_ENABLED=1
# NOTIFICATION_EMAIL_INTERVAL_MS=3600000
