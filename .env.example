# =============================================================================
# eBoom — local development configuration
# =============================================================================
# cp .env.example .env    then edit the values below.
#
# This file drives local development end to end: Compose reads it for every
# ${VAR} interpolation in compose.yaml (and, for infra/build-arg values only,
# in compose.prod.yaml too — see .env.prod.example), and the backend/frontend/
# docs dev containers load it directly via env_file. There is nothing else to
# configure for `docker compose up`.
#
# Production containers never read this file — they load .env.prod instead
# (see .env.prod.example). Only Compose-level interpolation (POSTGRES_*, port
# defaults, NEXT_PUBLIC_* build args) is shared between the two environments.
#
# The per-app files (eboom-backend/.env.sample, eboom-frontend/.env.example)
# are ONLY for running the apps directly with `npm run dev`, without Docker.
#
# NOTE: NEXT_PUBLIC_* values are baked into the frontend bundle at BUILD time.
# Changing them requires `--build`, not just a restart.


# =============================================================================
# 1. Database
# =============================================================================
POSTGRES_USER=eboom
POSTGRES_DB=eboom

# MUST CHANGE BEFORE PRODUCTION — interpolated directly into the postgres
# container's own environment, so it has to live here rather than .env.prod.
POSTGRES_PASSWORD=change-me-in-production

# The backend's DATABASE_URL is built from POSTGRES_* above and points at the
# bundled `postgres` service. Uncomment to use an external database instead
# (then you can also remove the postgres service from compose.yaml).
# DATABASE_URL=postgres://user:password@db.example.com:5432/eboom


# =============================================================================
# 2. Frontend build args
# =============================================================================
# Public URL of the API, as called from the browser. Baked into the frontend
# bundle at build time (see NOTE above) — must be the real https://api.<domain>
# value BEFORE running the production build.
NEXT_PUBLIC_BASE_URL=http://localhost:4000

# Landing page GitHub link (frontend + docs build arg).
NEXT_PUBLIC_GITHUB_URL=https://github.com/luminofy-space/eboom


# =============================================================================
# 3. Ports (local development only)
# =============================================================================
# Only used by compose.yaml. Ignored by compose.prod.yaml, which publishes
# only Caddy's 80/443 — safe to leave these at their defaults even on a
# production server.
FRONTEND_PORT=3000
BACKEND_PORT=4000
DOCS_PORT=4173

# Publish Postgres to the host, for TablePlus/DBeaver/psql.
POSTGRES_PORT=5432

# Docs dev server (`--profile docs`).
DOCS_DEV_PORT=5173

# Drizzle Studio (`--profile studio`).
STUDIO_PORT=4983

# Mailpit — catches all dev email instead of sending it for real.
# Web UI at http://localhost:8025. The backend is pointed at it by the
# EMAIL_* values in section 5 below; mail settings live there and only
# there, so nothing in this section can silently shadow them.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025


# =============================================================================
# 4. Auth behaviour
# =============================================================================
# Any value works locally — nothing here talks to a real identity provider.
JWT_SECRET=dev-only-secret-not-for-production

JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Matches FRONTEND_PORT above. Used for email links, OpenRouter
# HTTP-Referer, and as the allowed CORS origin on the API.
APP_URL=http://localhost:3000

# 1 = new signups are auto-verified and can log in without confirming their
# email — no SMTP setup needed for local dev.
SKIP_EMAIL_VERIFICATION=1

# DEV ONLY — bypasses authentication entirely with a fixed user id.
# TEST_USER_ID=1


# =============================================================================
# 5. Email (Mailpit)
# =============================================================================
# Mailpit, bundled with the dev Docker stack — signup/reset emails are
# captured at http://localhost:8025 instead of being sent for real.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_FROM=dev@eboom.local


# =============================================================================
# 6. AI insights & chat (optional)
# =============================================================================
# One provider-neutral set of variables. Leave unset to disable AI features —
# the AI endpoints then return a "not configured" error and nothing else breaks.
#
# OpenAI:
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#   (LLM_BASE_URL not needed)
#
# OpenRouter (https://openrouter.ai/settings/keys):
#   LLM_API_KEY=sk-or-v1-...
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=google/gemini-2.0-flash-exp:free
#
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
#
# (The legacy OPENAI_* / OPENROUTER_* names are still honoured as fallbacks,
#  but prefer the LLM_* names above — they take priority.)

# Background job that emails users about overdue items.
# NOTIFICATION_EMAIL_ENABLED=1
# NOTIFICATION_EMAIL_INTERVAL_MS=3600000
