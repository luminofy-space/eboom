# =============================================================================
# eBoom — single configuration file for the whole Docker stack
# =============================================================================
# cp .env.example .env    then edit the values below.
#
# This one file drives everything: docker-compose.yml, docker-compose.prod.yml,
# deploy/Caddyfile, the backend container's environment, and the frontend +
# docs build args. There is nothing else to configure.
#
# The per-app files (eboom-backend/.env.sample, eboom-frontend/.env.example)
# are ONLY for running the apps directly with `npm run dev`, without Docker.
#
# NOTE: NEXT_PUBLIC_* values are baked into the frontend bundle at BUILD time.
# Changing them requires `--build`, not just a restart.


# =============================================================================
# 1. MUST CHANGE BEFORE PRODUCTION
# =============================================================================

# Signing key for access + refresh tokens. Minimum 32 chars.
#   generate with:  openssl rand -base64 48
JWT_SECRET=change-me-in-production-minimum-32-characters

# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me-in-production

# Public URL of the frontend. Used for email links, OpenRouter HTTP-Referer,
# and as the allowed CORS origin on the API. Must match EXACTLY what the
# browser shows — no trailing slash, correct scheme.
APP_URL=http://localhost:3000

# Public URL of the API, as called from the browser. Build arg (see note above).
NEXT_PUBLIC_BASE_URL=http://localhost:4000


# =============================================================================
# 2. PRODUCTION: domains + TLS  (docker-compose.prod.yml + deploy/Caddyfile)
# =============================================================================
# Only used by the prod overlay. DNS A records for all three must already
# point at this server — Caddy requests Let's Encrypt certificates on boot.
APP_DOMAIN=eboom.example.com
API_DOMAIN=api.eboom.example.com
DOCS_DOMAIN=docs.eboom.example.com

# Address Let's Encrypt uses for expiry and problem notices.
ACME_EMAIL=admin@example.com

# With the domains above, section 1 becomes:
#   APP_URL=https://eboom.example.com
#   NEXT_PUBLIC_BASE_URL=https://api.eboom.example.com


# =============================================================================
# 3. Database
# =============================================================================
POSTGRES_USER=eboom
POSTGRES_DB=eboom

# The backend's DATABASE_URL is built from POSTGRES_* above and points at the
# bundled `postgres` service. Uncomment to use an external database instead
# (then you can also remove the postgres service from docker-compose.yml).
# DATABASE_URL=postgres://user:password@db.example.com:5432/eboom


# =============================================================================
# 4. Ports (local development only)
# =============================================================================
# Ignored by docker-compose.prod.yml, which publishes only Caddy's 80/443.
FRONTEND_PORT=3000
BACKEND_PORT=4000
DOCS_PORT=4173


# =============================================================================
# 5. Auth behaviour
# =============================================================================
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# 1 = new signups are auto-verified and can log in without confirming their
# email. Leave at 0 in production, or configure SMTP in section 6.
SKIP_EMAIL_VERIFICATION=0

# DEV ONLY — bypasses authentication entirely with a fixed user id.
# Never set this in production.
# TEST_USER_ID=1


# =============================================================================
# 6. SMTP — signup verification, password reset, notifications
# =============================================================================
# Required unless SKIP_EMAIL_VERIFICATION=1.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=noreply@example.com

# Background job that emails users about overdue items.
# NOTIFICATION_EMAIL_ENABLED=1
# NOTIFICATION_EMAIL_INTERVAL_MS=3600000


# =============================================================================
# 7. AI insights & chat (optional)
# =============================================================================
# One provider-neutral set of variables. Leave unset to disable AI features —
# the AI endpoints then return a "not configured" error and nothing else breaks.
#
# OpenAI:
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#   (LLM_BASE_URL not needed)
#
# OpenRouter (https://openrouter.ai/settings/keys):
#   LLM_API_KEY=sk-or-v1-...
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=google/gemini-2.0-flash-exp:free
#
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
#
# (The legacy OPENAI_* / OPENROUTER_* names are still honoured as fallbacks,
#  but prefer the LLM_* names above — they take priority.)


# =============================================================================
# 8. Misc
# =============================================================================
# Landing page GitHub link (frontend + docs build arg).
NEXT_PUBLIC_GITHUB_URL=https://github.com/luminofy-space/eboom
